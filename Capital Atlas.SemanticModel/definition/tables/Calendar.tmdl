	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 1970, 1, 1 ), DATE ( 2024, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM", "en-US" ),
				    "Month End", EOMONTH ( [Date], 0 ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Week", "W" & FORMAT ( WEEKNUM ( [Date], 2 ), "00" )
				)

	annotation PBI_Id = 5198195a607e47e9b2a3c88aabd30890

