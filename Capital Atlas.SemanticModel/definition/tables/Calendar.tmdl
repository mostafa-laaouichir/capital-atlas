		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		formatString: 0
		lineageTag: 79d3d070-558d-4d5d-b901-5ad4eedcd12f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Number]

