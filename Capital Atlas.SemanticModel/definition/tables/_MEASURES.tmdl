table _MEASURES
	lineageTag: 216bc7bd-9dca-4632-b00a-ba2a58eb8f29

	measure 'Sector Fixed Investment (2015 USD millions)' = IF (HASONEVALUE (Geography[Area Code]) && HASONEVALUE ('Calendar'[Year]), CALCULATE (SELECTEDVALUE (Capital_Stock[Value]), Capital_Stock[Item] = "Gross Fixed Capital Formation (Agriculture, Forestry and Fishing)", Capital_Stock[Element] = "Value US$, 2015 prices"))
		formatString: #,##0.00
		lineageTag: a5f26610-b3aa-4486-b2e1-4e96c0f9ceb4

	measure 'Sector Net Capital Stock (2015 USD millions)' = IF (HASONEVALUE (Geography[Area Code]) && HASONEVALUE ('Calendar'[Year]), CALCULATE (SELECTEDVALUE (Capital_Stock[Value]), Capital_Stock[Item] = "Net Capital Stocks (Agriculture, Forestry and Fishing)", Capital_Stock[Element] = "Value US$, 2015 prices"))
		formatString: #,##0.00
		lineageTag: 8bd1cc98-e29f-482d-8447-2b5a768f9ef0

	measure 'Sector Share of GDP %' = IF (HASONEVALUE (Geography[Area Code]) && HASONEVALUE ('Calendar'[Year]), CALCULATE (DIVIDE (SELECTEDVALUE (Key_Indicators[Value]), 100), Key_Indicators[Item] = "Value Added (Agriculture, Forestry and Fishing)", Key_Indicators[Element] = "Share of GDP US$, 2015 prices"))
		formatString: 0.00%
		lineageTag: d6b98111-09ad-453a-a298-a14c1a7ea421

	measure 'Sector Fixed Investment YoY %' =
			VAR CurrentValue = [Sector Fixed Investment (2015 USD millions)]
			VAR PriorValue = [Sector Fixed Investment Prior Year (2015 USD millions)]
			RETURN
			    IF (
			        NOT ISBLANK (CurrentValue) && NOT ISBLANK (PriorValue),
			        DIVIDE (CurrentValue - PriorValue, PriorValue)
			    )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Investment and Assets\YoY
		lineageTag: 8db09338-c82e-4403-8f3f-2704c93a2a11

	measure 'Sector Fixed Investment Prior Year (2015 USD millions)' =
			VAR CurrentYear = SELECTEDVALUE ('Calendar'[Year])
			RETURN
			    IF (
			        NOT ISBLANK (CurrentYear),
			        CALCULATE ([Sector Fixed Investment (2015 USD millions)], REMOVEFILTERS ('Calendar'), 'Calendar'[Year] = CurrentYear - 1)
			    )
		formatString: #,##0.00
		displayFolder: Investment and Assets\Prior Year
		lineageTag: 74307188-a239-48fb-95f3-64f517fad778

	measure 'Sector Fixed Investment YoY Change (2015 USD millions)' =
			VAR CurrentValue = [Sector Fixed Investment (2015 USD millions)]
			VAR PriorValue = [Sector Fixed Investment Prior Year (2015 USD millions)]
			RETURN
			    IF (
			        NOT ISBLANK (CurrentValue) && NOT ISBLANK (PriorValue),
			        CurrentValue - PriorValue
			    )
		formatString: +#,##0.00;-#,##0.00;#,##0.00
		displayFolder: Investment and Assets\YoY
		lineageTag: 62a22e76-5d3b-44f7-9a9b-683f364a345d

